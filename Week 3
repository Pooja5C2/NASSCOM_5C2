`np.sum()`        | Sum of all elements    | `np.sum(arr)`            |\n","| `np.mean()`       | Average of elements    | `np.mean(arr)`           |\n","| `np.median()`     | Middle value           | `np.median(arr)`         |\n","| `np.max()`        | Largest value          | `np.max(arr)`            |\n","| `np.min()`        | Smallest value         | `np.min(arr)`            |\n","| `np.ptp()`        | Range (Max − Min)      | `np.ptp(arr)`            |\n","| `np.std()`        | Standard deviation     | `np.std(arr)`            |\n","| `np.var()`        | Variance               | `np.var(arr)`            |\n","| `np.argmax()`     | Index of maximum value | `np.argmax(arr)`         |\n","| `np.argmin()`     | Index of minimum value | `np.argmin(arr)`         |\n","| `np.percentile()` | Percentile values      | `np.percentile(arr, 50)` |\n"],"metadata":{"id":"F3xj_fG42Fk6"}},{"cell_type":"code","source":["import numpy as np\n","\n","# Create a NumPy array\n","marks = np.array([75, 82, 90, 68, 95, 88, 79])\n","\n","print(\"Original Array:\", marks)\n","# Sort\n","print(\"Sorted Array:\", np.sort(marks))\n","# Sum\n","print(\"\\nSum:\", np.sum(marks))\n","\n","# Mean (Average)\n","print(\"Mean:\", np.mean(marks))\n","\n","# Median\n","print(\"Median:\", np.median(marks))\n","\n","# Maximum Value\n","print(\"Maximum:\", np.max(marks))\n","\n","# Minimum Value\n","print(\"Minimum:\", np.min(marks))\n","\n","# Range\n","print(\"Range:\", np.ptp(marks))\n","\n","# Standard Deviation\n","print(\"Standard Deviation:\", np.std(marks))\n","\n","# Variance\n","print(\"Variance:\", np.var(marks))\n","\n","# Index of Maximum Value\n","print(\"Index of Maximum:\", np.argmax(marks))\n","\n","# Index of Minimum Value\n","print(\"Index of Minimum:\", np.argmin(marks))\n","\n","# Percentiles\n","print(\"25th Percentile:\", np.percentile(marks, 25))\n","print(\"50th Percentile:\", np.percentile(marks, 50))\n","print(\"75th Percentile:\", np.percentile(marks, 75))"],"metadata":{"cola