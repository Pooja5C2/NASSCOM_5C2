      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def check_age(age):\n",
        "    if age < 0:\n",
        "        raise ValueError(\"Age cannot be negative!\")\n",
        "    else:\n",
        "        print(\"Age is valid.\")\n",
        "\n",
        "try:\n",
        "    check_age(-5)\n",
        "except ValueError as e:\n",
        "    print(\"Caught an exception:\", e)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "_jYzSHgDkjgI",
        "outputId": "6c6dcbc7-02ee-4f6a-9022-ffaa5dfc25a1"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Caught an exception: Age cannot be negative!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def divide(a, b):\n",
        "    print(f\"Dividing {a} by {b}\")  # Debug info\n",
        "    return a / b\n",
        "\n",
        "print(divide(10, 2))  # Correct\n",
        "# print(divide(10, 0))  # Uncomment to see the crash"
