{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMP4oGYPQBGjLihgLa1ft4J"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","metadata":{"id":"MKXT2AxttbD7"},"source":["#1. Derivatives — the slope of a function"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"hdwr0adytbD7","executionInfo":{"status":"ok","timestamp":1786953369114,"user_tz":-330,"elapsed":47,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"4289d8b8-8535-4a4b-bedd-8766b6bbed95"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Numerical f'(3): 6.0  (exact = 6)\n"]}],"source":["# -----------------------------------------------------------\n","# 🔹 1A. NUMERICAL DERIVATIVE (finite difference)\n","# -----------------------------------------------------------\n","\n","# The derivative is the slope: how much f changes for a tiny step h\n","def f(x):\n","    return x**2\n","\n","h = 1e-6\n","slope_at_3 = (f(3 + h) - f(3)) / h\n","print('Numerical f\\'(3):', round(slope_at_3, 4), ' (exact = 6)')"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"iMDH-2TMtbD7","executionInfo":{"status":"ok","timestamp":1786953372222,"user_tz":-330,"elapsed":151,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"75d349a5-62f3-4c56-d66f-384d78e20f85"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["d/dx (x**2) = 2*x\n","Symbolic f'(3) = 6\n"]}],"source":["# -----------------------------------------------------------\n","# 🔹 1B. SYMBOLIC DERIVATIVE (SymPy)\n","# -----------------------------------------------------------\n","\n","expr = x**2\n","deriv = sp.diff(expr, x)          # differentiate w.r.t. x\n","print('d/dx (x**2) =', deriv)     # 2*x\n","\n","# Evaluate the symbolic derivative at x = 3\n","print('Symbolic f\\'(3) =', deriv.subs(x, 3))"]},{"cell_type":"markdown","metadata":{"id":"x_S7X5OgtbD7"},"source":["#### 🧪 LAB EXERCISE 1 — Numerical vs symbolic derivative\n","\n","For the function `g(x) = x**3 + 2*x`:\n","1. Compute the **numerical** derivative at `x = 2` using a finite difference.\n","2. Compute the **symbolic** derivative with `sp.diff` and print it.\n","3. Evaluate the symbolic derivative at `x = 2` and confirm it matches step 1."]},{"cell_type":"code","source":["def g(x):\n","    return x**3 + 2*x\n","\n","\n","# 1. Numerical derivative at x = 2 (use h = 1e-6)\n","h = 1e-6\n","x = 2\n","\n","numerical_derivative = (g(x + h) - g(x)) / h\n","\n","print(\"Numerical derivative at x = 2:\", numerical_derivative)\n","\n","\n","# 2. Symbolic derivative of x**3 + 2*x\n","import sympy as sp\n","\n","x_symbol = sp.Symbol('x')\n","g_symbolic = x_symbol**3 + 2*x_symbol\n","\n","symbolic_derivative = sp.diff(g_symbolic, x_symbol)\n","\n","print(\"Symbolic derivative:\", symbolic_derivative)\n","\n","\n","# 3. Evaluate the symbolic derivative at x = 2 and compare\n","symbolic_at_2 = symbolic_derivative.subs(x_symbol, 2)\n","\n","print(\"Symbolic derivative at x = 2:\", symbolic_at_2)\n","print(\"Numerical derivative at x = 2:\", numerical_derivative)\n","print(\"Difference:\", abs(numerical_derivative - float(symbolic_at_2)))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kyRtAe3EvRp7","executionInfo":{"status":"ok","timestamp":1786953707918,"user_tz":-330,"elapsed":5271,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"423e82a2-3779-418d-cd7d-0e52c98e41e1"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Numerical derivative at x = 2: 14.000006002490295\n","Symbolic derivative: 3*x**2 + 2\n","Symbolic derivative at x = 2: 14\n","Numerical derivative at x = 2: 14.000006002490295\n","Difference: 6.002490295031748e-06\n"]}]},{"cell_type":"markdown","metadata":{"id":"k7ehmSJStbD8"},"source":["#2. Partial derivatives & the gradient"]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 2A. PARTIAL DERIVATIVES\n","# -----------------------------------------------------------\n","\n","import sympy as sp\n","\n","# Define variables\n","x, y = sp.symbols('x y')\n","\n","# Define the function\n","f2 = x**2 + 3*x*y + y**2\n","\n","# A partial derivative differentiates ONE variable,\n","# holding the other variables fixed\n","\n","print('f(x, y) =', f2)\n","\n","# Partial derivative with respect to x\n","print('df/dx =', sp.diff(f2, x))\n","\n","# Partial derivative with respect to y\n","print('df/dy =', sp.diff(f2, y))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nCpCm6uvvjIc","executionInfo":{"status":"ok","timestamp":1786953744367,"user_tz":-330,"elapsed":28,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"8169c9a5-289a-46b2-860a-8ae3b27f5406"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["f(x, y) = x**2 + 3*x*y + y**2\n","df/dx = 2*x + 3*y\n","df/dy = 3*x + 2*y\n"]}]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 2B. THE GRADIENT (vector of partials)\n","# -----------------------------------------------------------\n","\n","import sympy as sp\n","\n","# Define variables\n","x, y = sp.symbols('x y')\n","\n","# Define the function\n","f2 = x**2 + 3*x*y + y**2\n","\n","# The gradient stacks every partial derivative into one vector\n","grad = [sp.diff(f2, v) for v in (x, y)]\n","\n","print('grad f =', grad)\n","\n","# Evaluate the gradient at the point (x=1, y=2)\n","grad_at = [g.subs({x: 1, y: 2}) for g in grad]\n","\n","print('grad f at (1, 2) =', grad_at)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QUNTu7_hvoFj","executionInfo":{"status":"ok","timestamp":1786953765158,"user_tz":-330,"elapsed":10,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"11501282-8aa2-42c3-cd17-b0ed7e6fa7e1"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["grad f = [2*x + 3*y, 3*x + 2*y]\n","grad f at (1, 2) = [8, 7]\n"]}]},{"cell_type":"markdown","metadata":{"id":"Tk-Io8jRtbD8"},"source":["#### 🧪 LAB EXERCISE 2 — Compute a gradient\n","\n","For `h2 = x**2 * y + sp.sin(y)`:\n","1. Compute `dh/dx` and `dh/dy` with `sp.diff`.\n","2. Assemble the gradient as a list `[dh/dx, dh/dy]`.\n","3. Evaluate the gradient at the point `(x=2, y=0)`."]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 2C. GRADIENT OF A NEW FUNCTION\n","# -----------------------------------------------------------\n","\n","import sympy as sp\n","\n","# Define variables\n","x, y = sp.symbols('x y')\n","\n","# Define the function\n","h2 = x**2 * y + sp.sin(y)\n","\n","\n","# 1. dh/dx and dh/dy\n","dh_dx = sp.diff(h2, x)\n","dh_dy = sp.diff(h2, y)\n","\n","print('dh/dx =', dh_dx)\n","print('dh/dy =', dh_dy)\n","\n","\n","# 2. Assemble the gradient list\n","grad_h = [dh_dx, dh_dy]\n","\n","print('grad h =', grad_h)\n","\n","\n","# 3. Evaluate at (x=2, y=0)\n","grad_h_at = [g.subs({x: 2, y: 0}) for g in grad_h]\n","\n","print('grad h at (2, 0) =', grad_h_at)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-1muUrafv1d7","executionInfo":{"status":"ok","timestamp":1786953824445,"user_tz":-330,"elapsed":8,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"270d361e-f5a7-4296-83a4-e96f55b56829"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["dh/dx = 2*x*y\n","dh/dy = x**2 + cos(y)\n","grad h = [2*x*y, x**2 + cos(y)]\n","grad h at (2, 0) = [0, 5]\n"]}]},{"cell_type":"markdown","metadata":{"id":"X8RdMj7MtbD8"},"source":["#3. The chain rule"]},{"cell_type":"code","metadata":{"id":"VtnYjnj3tbD8","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1786953865691,"user_tz":-330,"elapsed":51,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"09cbe2b6-2d41-4b44-c9cb-5ea92de5b229"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["By hand : 2*x*cos(x**2)\n","By SymPy: 2*x*cos(x**2)\n","Match?   True\n"]}],"source":["# -----------------------------------------------------------\n","# 🔹 3A. CHAIN RULE BY HAND vs SymPy\n","# -----------------------------------------------------------\n","\n","# y = sin(x**2) is a composition: outer = sin(u), inner = u = x**2\n","# Chain rule:  dy/dx = cos(u) * du/dx = cos(x**2) * 2x\n","by_hand = sp.cos(x**2) * 2*x\n","by_sympy = sp.diff(sp.sin(x**2), x)\n","\n","print('By hand :', by_hand)\n","print('By SymPy:', by_sympy)\n","print('Match?  ', sp.simplify(by_hand - by_sympy) == 0)"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ylpJu3S8tbD9","executionInfo":{"status":"ok","timestamp":1786953871877,"user_tz":-330,"elapsed":20,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"e83c0a9e-aa1c-4978-df8d-4b1f9486afbc"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["d/dx (3x+1)^4 = 12*(3*x + 1)**3\n"]}],"source":["# -----------------------------------------------------------\n","# 🔹 3B. CHAINING THREE FUNCTIONS\n","# -----------------------------------------------------------\n","\n","# y = (3x + 1)**4  -> outer^4, inner (3x+1)\n","expr3 = (3*x + 1)**4\n","print('d/dx (3x+1)^4 =', sp.diff(expr3, x))   # 12*(3x+1)^3"]},{"cell_type":"markdown","metadata":{"id":"p3hHWRvytbD9"},"source":["#### 🧪 LAB EXERCISE 3 — Chain rule\n","\n","For `y = sp.exp(x**2 + 1)`:\n","1. Write the chain-rule result **by hand** as a SymPy expression (outer derivative × inner derivative).\n","2. Differentiate the same expression with `sp.diff`.\n","3. Confirm the two match using `sp.simplify(by_hand - by_sympy) == 0`."]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 3A. CHAIN RULE\n","# -----------------------------------------------------------\n","\n","import sympy as sp\n","\n","# Define the variable\n","x = sp.Symbol('x')\n","\n","# y = exp(x**2 + 1)\n","y = sp.exp(x**2 + 1)\n","\n","\n","# 1. By hand (as a SymPy expression)\n","# Outer derivative: exp(inner)\n","# Inner derivative: 2*x\n","# Therefore: y' = exp(x**2 + 1) * 2*x\n","\n","dy_hand = sp.exp(x**2 + 1) * (2*x)\n","\n","print(\"By hand:\", dy_hand)\n","\n","\n","# 2. With sp.diff\n","dy_diff = sp.diff(y, x)\n","\n","print(\"With sp.diff:\", dy_diff)\n","\n","\n","# 3. Confirm they match\n","print(\"Do they match?\", sp.simplify(dy_hand - dy_diff) == 0)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oE9Qv9hOwME7","executionInfo":{"status":"ok","timestamp":1786953913279,"user_tz":-330,"elapsed":45,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"a32195a6-47c6-47d6-e67d-559f822c6941"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["By hand: 2*x*exp(x**2 + 1)\n","With sp.diff: 2*x*exp(x**2 + 1)\n","Do they match? True\n"]}]},{"cell_type":"markdown","metadata":{"id":"S6f5MJWXtbD9"},"source":["#4. Backpropagation — the chain rule in a network\n","\n","A 2-layer network is just a composition:  **x → (W1) → ReLU → (W2) → y_hat**. Backprop applies the chain rule from the loss backwards to every weight."]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 4A. FORWARD PASS\n","# -----------------------------------------------------------\n","\n","import numpy as np\n","\n","# Tiny toy problem:\n","# 4 samples, 3 input features, 5 hidden units, 1 output\n","\n","# Input data\n","X = np.random.randn(4, 3)\n","\n","# Target values\n","Y = np.random.randn(4, 1)\n","\n","# Weight matrices\n","W1 = np.random.randn(3, 5) * 0.1\n","W2 = np.random.randn(5, 1) * 0.1\n","\n","\n","# Layer 1: Linear transformation\n","z1 = X @ W1\n","\n","# ReLU activation\n","h = np.maximum(0, z1)\n","\n","# Layer 2: Linear transformation\n","y_hat = h @ W2\n","\n","# Mean Squared Error loss\n","loss = ((y_hat - Y) ** 2).mean()\n","\n","# Print initial loss\n","print('Initial loss:', round(loss, 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TdNjaPfqwvMU","executionInfo":{"status":"ok","timestamp":1786954060688,"user_tz":-330,"elapsed":49,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"7870c162-4b54-4aa2-fccc-7bd0b4a1c644"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Initial loss: 0.4234\n"]}]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 4B. BACKWARD PASS (gradients via the chain rule)\n","# -----------------------------------------------------------\n","\n","# Work backwards from the loss, one link at a time\n","\n","# d loss / d y_hat\n","dy = 2 * (y_hat - Y) / Y.size\n","\n","# d loss / d W2\n","dW2 = h.T @ dy\n","\n","# d loss / d h\n","dh = dy @ W2.T\n","\n","# ReLU gradient\n","# 1 where z1 > 0, otherwise 0\n","dz1 = dh * (z1 > 0)\n","\n","# d loss / d W1\n","dW1 = X.T @ dz1\n","\n","\n","# Print gradient shapes\n","print('dW1 shape:', dW1.shape, '(matches W1)')\n","print('dW2 shape:', dW2.shape, '(matches W2)')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"m8jTQhLLw46M","executionInfo":{"status":"ok","timestamp":1786954099493,"user_tz":-330,"elapsed":46,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"dda9d168-2d14-4275-8209-56a2ac9e73ec"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["dW1 shape: (3, 5) (matches W1)\n","dW2 shape: (5, 1) (matches W2)\n"]}]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 4C. ONE GRADIENT-DESCENT STEP SHOULD LOWER THE LOSS\n","# -----------------------------------------------------------\n","\n","# Learning rate\n","lr = 0.1\n","\n","# Update the weights by moving opposite to the gradients\n","W1 -= lr * dW1\n","W2 -= lr * dW2\n","\n","\n","# Recompute the forward pass after the update\n","h_new = np.maximum(0, X @ W1)\n","\n","y_hat_new = h_new @ W2\n","\n","# Recompute the loss\n","loss_new = ((y_hat_new - Y) ** 2).mean()\n","\n","\n","# Compare the losses\n","print('Loss before:', round(loss, 4))\n","print('Loss after :', round(loss_new, 4), '-> should be lower')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"iEWPzrvHw-rE","executionInfo":{"status":"ok","timestamp":1786954120010,"user_tz":-330,"elapsed":11,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"a7fa4887-c9e5-4a60-fcf1-4f38f38b9e94"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Loss before: 0.4234\n","Loss after : 0.4196 -> should be lower\n"]}]},{"cell_type":"markdown","metadata":{"id":"sGIyqcdZtbD9"},"source":["#### 🧪 LAB EXERCISE 4 — Derive the gradients for a 2-layer network\n","\n","Fresh weights are set up below. Using the chain rule (reuse the pattern from 4A/4B):\n","1. Run the **forward pass**: compute `z1`, `h` (ReLU), `y_hat`, and `loss`.\n","2. Run the **backward pass**: compute `dy`, `dW2`, `dh`, `dz1`, `dW1`.\n","3. Take one gradient-descent step (`lr = 0.05`) and print the loss before and after."]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 4D. FULL FORWARD + BACKWARD PASS\n","# -----------------------------------------------------------\n","\n","import numpy as np\n","\n","Xb = np.random.randn(6, 4)\n","Yb = np.random.randn(6, 1)\n","Wa = np.random.randn(4, 8) * 0.1     # input -> hidden\n","Wb = np.random.randn(8, 1) * 0.1     # hidden -> output\n","\n","\n","# 1. Forward pass\n","z1 = Xb @ Wa\n","h = np.maximum(0, z1)                 # ReLU\n","y_hat = h @ Wb\n","loss = ((y_hat - Yb) ** 2).mean()\n","\n","\n","# 2. Backward pass\n","dy = 2 * (y_hat - Yb) / Yb.size\n","dWb = h.T @ dy\n","dh = dy @ Wb.T\n","dz1 = dh * (z1 > 0)\n","dWa = Xb.T @ dz1\n","\n","\n","# 3. One gradient-descent step\n","lr = 0.05\n","\n","Wa -= lr * dWa\n","Wb -= lr * dWb\n","\n","\n","# Recompute the loss after updating the weights\n","h_new = np.maximum(0, Xb @ Wa)\n","y_hat_new = h_new @ Wb\n","loss_new = ((y_hat_new - Yb) ** 2).mean()\n","\n","\n","# Print results\n","print(\"Loss before:\", round(loss, 4))\n","print(\"Loss after :\", round(loss_new, 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"twAfYLNyxGrk","executionInfo":{"status":"ok","timestamp":1786954153166,"user_tz":-330,"elapsed":48,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"2af2f84b-1e40-4684-cc3a-e25117fd58ac"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Loss before: 0.2351\n","Loss after : 0.2346\n"]}]},{"cell_type":"markdown","metadata":{"id":"OI90eMY4tbD9"},"source":["#5. Hessian & gradient descent"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nxu-mGvetbD-","executionInfo":{"status":"ok","timestamp":1786954255297,"user_tz":-330,"elapsed":19,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"331d58e8-ef88-448b-c97e-59c6e55e75ed"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Hessian of f:\n","⎡2  3⎤\n","⎢    ⎥\n","⎣3  2⎦\n"]}],"source":["# -----------------------------------------------------------\n","# 🔹 5A. THE HESSIAN (matrix of second derivatives = curvature)\n","# -----------------------------------------------------------\n","\n","import sympy as sp\n","\n","# Define variables\n","x, y = sp.symbols('x y')\n","\n","# Define the function\n","f5 = x**2 + 3*x*y + y**2\n","\n","# Calculate the Hessian matrix\n","H = sp.hessian(f5, (x, y))\n","\n","# Print the Hessian\n","print('Hessian of f:')\n","sp.pprint(H)"]},{"cell_type":"code","metadata":{"id":"NwVwbGtVtbD-","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1786954272934,"user_tz":-330,"elapsed":47,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"6b1f11b2-1d64-4f90-8734-c9e363ec1b0b"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Converged x: 3.998  (true minimum = 4)\n"]}],"source":["# -----------------------------------------------------------\n","# 🔹 5B. GRADIENT DESCENT ON A SIMPLE FUNCTION\n","# -----------------------------------------------------------\n","\n","# Minimise f(x) = (x - 4)**2, whose minimum is at x = 4.\n","# Update rule:  x <- x - lr * f'(x),  with f'(x) = 2*(x - 4)\n","xv = 0.0          # starting point\n","lr = 0.2\n","for step in range(15):\n","    grad = 2 * (xv - 4)        # the derivative\n","    xv = xv - lr * grad        # step against the gradient\n","print('Converged x:', round(xv, 3), ' (true minimum = 4)')"]},{"cell_type":"markdown","metadata":{"id":"7vaHh-ZRtbD-"},"source":["#### 🧪 LAB EXERCISE 5 — Hessian + gradient descent\n","\n","1. Compute the **Hessian** of `f = x**4 + y**2` with `sp.hessian`.\n","2. Run **gradient descent** to minimise `f(x) = (x - 7)**2`:\n","   start at `x = 0`, `lr = 0.1`, 20 steps, using `f'(x) = 2*(x - 7)`. Print the final `x` (should approach 7)."]},{"cell_type":"code","source":["# -----------------------------------------------------------\n","# 🔹 5B. HESSIAN + GRADIENT DESCENT\n","# -----------------------------------------------------------\n","\n","import sympy as sp\n","\n","# Define variables\n","x, y = sp.symbols('x y')\n","\n","\n","# 1. Hessian of x**4 + y**2\n","f = x**4 + y**2\n","\n","H = sp.hessian(f, (x, y))\n","\n","print('Hessian:')\n","sp.pprint(H)\n","\n","\n","# 2. Gradient descent to minimise (x - 7)**2\n","\n","xv = 0.0\n","lr = 0.1\n","\n","for step in range(20):\n","    # Function: (x - 7)^2\n","    # Gradient: 2(x - 7)\n","    grad = 2 * (xv - 7)\n","\n","    # Move opposite to the gradient\n","    xv = xv - lr * grad\n","\n","print('Final x:', xv)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"YknIHHCUxrvG","executionInfo":{"status":"ok","timestamp":1786954303668,"user_tz":-330,"elapsed":318,"user":{"displayName":"UPPALANCHI POOJA","userId":"15449918472587154783"}},"outputId":"20d63693-cbae-4a3d-8b51-9a106cc5f369"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["Hessian:\n","⎡    2   ⎤\n","⎢12⋅x   0⎥\n","⎢        ⎥\n","⎣  0    2⎦\n","Final x: 6.91929549467752\n"]}]}]}